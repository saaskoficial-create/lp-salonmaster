---
import BrandLogo from "./BrandLogo.astro";

const nav = [
  ["Plataforma", "#plataforma"],
  ["Como funciona", "#como-funciona"],
  ["Para quem é", "#para-quem"],
  ["Dúvidas", "#duvidas"],
];
const trialUrl = "https://salonmaster.com.br/cadastro";
---

<header class="sm-header">
  <div class="container sm-header__inner">
    <a class="sm-brand" href="#inicio" aria-label="SalonMaster - página inicial"
      ><BrandLogo decorative /></a
    >
    <nav aria-label="Navegação principal">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="button button--primary sm-header__cta" href={trialUrl}
      >Começar teste grátis <span aria-hidden="true">→</span></a
    >
    <button
      class="sm-menu"
      type="button"
      aria-label="Abrir navegação"
      aria-expanded="false"
      data-menu-button><i></i><i></i></button
    >
  </div>
  <div class="sm-header__mobile" hidden data-mobile-menu>
    {nav.map(([label, href]) => <a href={href}>{label}</a>)}<a href={trialUrl}
      >Começar teste grátis</a
    >
  </div>
</header>
<script>
  const button =
    document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    if (menu) menu.hidden = expanded;
  });
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.hidden = true;
      button?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
<style>
  .sm-header {
    position: fixed;
    z-index: 30;
    top: 0;
    width: 100%;
    border-bottom: 1px solid var(--color-border);
    background: rgb(255 252 249 / 0.9);
    backdrop-filter: blur(14px);
  }
  .sm-header__inner {
    display: flex;
    height: 5rem;
    align-items: center;
    gap: 2rem;
  }
  .sm-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .sm-brand :global(.brand-logo) {
    --brand-logo-symbol-size: 2rem;
    --brand-logo-wordmark-size: 1.1rem;
  }
  .sm-header nav {
    display: flex;
    gap: 1.8rem;
    margin: auto;
  }
  .sm-header nav a {
    color: var(--color-text-body);
    font-size: 0.82rem;
    font-weight: 730;
    text-decoration: none;
  }
  .sm-header nav a:hover {
    color: var(--color-brand-text);
  }
  .sm-header__cta {
    min-height: 2.9rem;
    padding: 0.65rem 1rem;
    font-size: 0.78rem;
  }
  .sm-menu,
  .sm-header__mobile {
    display: none;
  }
  @media (max-width: 58rem) {
    .sm-header__inner {
      height: 4.6rem;
    }
    .sm-header nav,
    .sm-header__cta {
      display: none;
    }
    .sm-menu {
      display: grid;
      width: 2.7rem;
      height: 2.7rem;
      align-content: center;
      justify-content: center;
      gap: 0.32rem;
      margin-left: auto;
      border: 1px solid var(--color-border);
      border-radius: 0.65rem;
      background: var(--color-bg-card);
    }
    .sm-menu i {
      display: block;
      width: 1.05rem;
      height: 1.5px;
      background: var(--color-text-heading);
    }
    .sm-header__mobile {
      display: grid;
      border-top: 1px solid var(--color-border);
      background: var(--color-bg-page);
      padding: 1rem 1.25rem 1.2rem;
    }
    .sm-header__mobile a {
      padding: 0.8rem 0;
      color: var(--color-text-heading);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
    }
    .sm-header__mobile a:last-child {
      color: var(--color-brand-text);
    }
  }
</style>
