---
import BrandLogo from "./BrandLogo.astro";

const trialUrl = "https://salonmaster.com.br/cadastro";
---

<footer class="sm-footer">
  <div class="container sm-footer__grid">
    <div>
      <a
        class="sm-brand"
        href="#inicio"
        aria-label="SalonMaster - página inicial"
      >
        <BrandLogo variant="negative" decorative />
      </a>
      <p>
        Gestão mais organizada para salões, barbearias e negócios de estética.
      </p>
    </div>
    <div>
      <strong>Plataforma</strong><a href="#plataforma">Funcionalidades</a><a
        href="#como-funciona">Como funciona</a
      ><a href="#para-quem">Para sua operação</a>
    </div>
    <div>
      <strong>Comece agora</strong><a href={trialUrl}>Começar teste grátis</a><a
        href="#duvidas">Dúvidas frequentes</a
      ><a
        href="https://salonmaster.com.br/"
        target="_blank"
        rel="noopener noreferrer">Site atual</a
      >
    </div>
  </div>
  <div class="container sm-footer__bottom">
    <span
      >© {new Date().getFullYear()} SalonMaster. Todos os direitos reservados.</span
    ><span>Agenda, clientes e gestão em uma mesma visão.</span>
  </div>
</footer>
<style>
  .sm-footer {
    border-top: 1px solid var(--color-premium);
    background: var(--color-bg-hero);
    padding: 4rem 0 1.3rem;
  }
  .sm-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3rem;
  }
  .sm-footer .sm-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .sm-footer .sm-brand :global(.brand-logo) {
    --brand-logo-symbol-size: 2.15rem;
    --brand-logo-wordmark-size: 1.16rem;
  }
  .sm-footer p {
    max-width: 17rem;
    margin-top: 1rem;
    color: rgb(255 253 251 / 72%);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .sm-footer__grid > div:not(:first-child) {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .sm-footer strong {
    color: var(--color-text-inverse);
    font-size: 0.78rem;
  }
  .sm-footer a:not(.sm-brand) {
    color: rgb(255 253 251 / 72%);
    font-size: 0.78rem;
    text-decoration: none;
  }
  .sm-footer a:hover {
    color: var(--color-brand);
  }
  .sm-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    border-top: 1px solid rgb(255 253 251 / 16%);
    padding-top: 1.25rem;
    color: rgb(255 253 251 / 56%);
    font-size: 0.67rem;
  }
  @media (max-width: 40rem) {
    .sm-footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sm-footer__bottom {
      display: grid;
    }
  }
</style>
