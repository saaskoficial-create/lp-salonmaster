---
import { ChevronDown, CircleQuestionMark } from "@lucide/astro";
import { faqItems, objections } from "../data/content";
---

<section
  class="objections section section--soft"
  aria-labelledby="objections-title"
>
  <div class="container">
    <div class="section-header section-header--center">
      <p class="eyebrow" data-reveal>Complementa o que você já usa</p>
      <h2 class="section-title" id="objections-title" data-reveal>
        O desafio não é só visualizar. <span class="text-gradient"
          >É preparar o dado para ser útil.</span
        >
      </h2>
    </div>

    <div class="objections__grid mobile-snap" aria-label="Objeções comuns">
      {
        objections.map((item) => (
          <article data-reveal>
            <CircleQuestionMark
              size={23}
              stroke-width={1.8}
              aria-hidden="true"
            />
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
    <p class="mobile-scroll-hint" aria-hidden="true">
      Deslize para ver as respostas â†’
    </p>
  </div>
</section>

<section class="faq section" id="duvidas" aria-labelledby="faq-title">
  <div class="container faq__layout">
    <div class="faq__intro">
      <p class="eyebrow" data-reveal>Dúvidas frequentes</p>
      <h2 class="section-title" id="faq-title" data-reveal>
        O essencial para começar com clareza.
      </h2>
      <p class="section-copy" data-reveal>
        Cada projeto é analisado conforme os canais, os dados disponíveis e os
        objetivos da indústria.
      </p>
    </div>

    <div class="faq__items" data-reveal>
      {
        faqItems.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <span>{item.question}</span>
              <ChevronDown size={20} aria-hidden="true" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .objections__grid {
    display: grid;
    gap: 1rem;
  }

  .objections__grid article {
    border: 1px solid var(--border);
    border-radius: var(--radius-medium);
    background: var(--white);
    padding: 1.5rem;
  }

  .objections__grid :global(svg) {
    color: var(--cyan);
  }

  .objections__grid h3 {
    margin-top: 1rem;
    font-size: 1.13rem;
  }

  .objections__grid p {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .faq__layout {
    display: grid;
    gap: 3rem;
  }

  .faq__intro h2 {
    margin-top: 0.9rem;
  }

  .faq__intro p {
    margin-top: 1rem;
  }

  .faq__items {
    border-top: 1px solid var(--border);
  }

  .faq details {
    border-bottom: 1px solid var(--border);
  }

  .faq summary {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
    cursor: pointer;
    font-weight: 730;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary :global(svg) {
    flex: 0 0 auto;
    color: var(--cyan);
    transition: rotate var(--transition);
  }

  .faq details[open] summary :global(svg) {
    rotate: 180deg;
  }

  .faq details p {
    max-width: 44rem;
    padding: 0 2.5rem 1.35rem 0;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .objections__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .faq__layout {
      grid-template-columns: 0.72fr 1.28fr;
      gap: 6rem;
    }
  }

  @media (max-width: 47.999rem) {
    .objections__grid {
      display: flex;
    }

    .objections__grid article {
      min-height: 14rem;
      padding: 1.35rem;
    }

    .faq__layout {
      gap: 1.75rem;
    }

    .faq summary {
      min-height: 3.75rem;
      font-size: 0.93rem;
    }

    .faq details p {
      padding-bottom: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
